<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: title on the left, Reports and Profile on the top-right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/purple"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/greeting"
                    style="@style/CardTitle"
                    android:textSize="18sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/open_reports"
                style="@style/IconButton"
                android:contentDescription="@string/reports_title"
                android:src="@drawable/ic_chart" />
            <ImageButton
                android:id="@+id/edit_profile"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/edit_profile"
                android:src="@drawable/ic_person" />
        </LinearLayout>

        <TextView
            style="@style/CardBody"
            android:layout_marginTop="8dp"
            android:text="@string/tagline" />

        <!-- Shown until the accessibility service is switched on. -->
        <LinearLayout
            android:id="@+id/setup_card"
            style="@style/Card"
            android:background="@drawable/card_warning">

            <TextView style="@style/CardTitle" android:text="@string/setup_title" />
            <TextView style="@style/CardBody" android:text="@string/setup_body" />
            <Button
                android:id="@+id/setup_button"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_button" />

            <LinearLayout
                android:id="@+id/restricted_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/CardBody"
                    android:layout_marginTop="12dp"
                    android:text="@string/restricted_body" />
                <Button
                    android:id="@+id/restricted_button"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/restricted_button" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card" android:gravity="center_horizontal">
            <io.github.nuhanhabib.dozypal.CharacterView
                android:id="@+id/character"
                android:layout_width="220dp"
                android:layout_height="220dp" />

            <TextView
                android:id="@+id/mood_title"
                style="@style/CardTitle"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/mood_line"
                style="@style/CardBody"
                android:gravity="center" />

            <TextView
                android:id="@+id/total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text"
                android:textSize="48sp"
                android:textStyle="bold" />
            <TextView
                style="@style/CardBody"
                android:layout_width="wrap_content"
                android:text="@string/reels_today" />
            <TextView
                style="@style/CardBody"
                android:gravity="center"
                android:text="@string/reset_note"
                android:textSize="12sp" />

            <!-- Progress towards the daily limit; shown only when a limit is set. -->
            <LinearLayout
                android:id="@+id/limit_progress_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/limit_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />
                <TextView
                    android:id="@+id/limit_progress_text"
                    style="@style/CardBody"
                    android:gravity="center"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <LinearLayout style="@style/AppCount">
                    <TextView android:id="@+id/facebook_count" style="@style/AppCountNumber" />
                    <TextView style="@style/AppCountLabel" android:text="@string/facebook" />
                </LinearLayout>
                <LinearLayout style="@style/AppCount">
                    <TextView android:id="@+id/instagram_count" style="@style/AppCountNumber" />
                    <TextView style="@style/AppCountLabel" android:text="@string/instagram" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <LinearLayout style="@style/AppCount">
                    <TextView android:id="@+id/tiktok_count" style="@style/AppCountNumber" />
                    <TextView style="@style/AppCountLabel" android:text="@string/tiktok" />
                </LinearLayout>
                <LinearLayout style="@style/AppCount">
                    <TextView android:id="@+id/youtube_count" style="@style/AppCountNumber" />
                    <TextView style="@style/AppCountLabel" android:text="@string/youtube" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:text="@string/limit_title" />
                    <TextView style="@style/CardBody" android:text="@string/limit_body" />
                </LinearLayout>
                <Switch
                    android:id="@+id/limit_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/limit_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/limit_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/limit_minus"
                        style="@style/SecondaryButton"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/limit_less"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="−"
                        android:textSize="22sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/limit_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                        <TextView
                            style="@style/CardBody"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="0dp"
                            android:text="@string/limit_unit" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/limit_plus"
                        style="@style/SecondaryButton"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/limit_more"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="+"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- Quick picks, filled in from DailyLimit.PRESETS. -->
                <LinearLayout
                    android:id="@+id/limit_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/segment_bg"
                    android:orientation="horizontal"
                    android:padding="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/limit_sound" />
                    <Switch
                        android:id="@+id/limit_sound_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/limit_sound" />
                </LinearLayout>
                <TextView style="@style/CardBody" android:text="@string/limit_hint" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:text="@string/counter_title" />
                    <TextView style="@style/CardBody" android:text="@string/counter_body" />
                </LinearLayout>
                <Switch
                    android:id="@+id/counter_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/counter_title" />
            </LinearLayout>

            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="16dp"
                android:text="@string/position_title" />
            <RadioGroup
                android:id="@+id/side_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/side_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/left" />
                <RadioButton
                    android:id="@+id/side_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/right" />
            </RadioGroup>
            <TextView style="@style/CardBody" android:text="@string/drag_hint" />

            <TextView
                android:id="@+id/opacity_label"
                style="@style/CardTitle"
                android:layout_marginTop="16dp" />
            <SeekBar
                android:id="@+id/opacity_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/opacity_description" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/friends_title" />
            <TextView style="@style/CardBody" android:text="@string/friends_body" />
            <Button
                android:id="@+id/open_battles"
                style="@style/PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_battles" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="16dp">
            <TextView style="@style/CardTitle" android:text="@string/privacy_title" />
            <TextView style="@style/CardBody" android:text="@string/privacy_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
